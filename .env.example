# 텔레그램 봇 (@BotFather에서 발급)
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# (선택) 옵시디언 Local REST API 플러그인 — 단어장 기능용
OBSIDIAN_API=http://127.0.0.1:27123
OBSIDIAN_KEY=your-obsidian-rest-api-key

# (선택) 저장함 웹페이지 — Cloudflare Pages. SITE_URL이 없으면 🔖 저장 기능 전체가 꺼짐
SITE_URL=https://news.example.com
# (선택) 내 뉴스방 제목에 쓸 이름 — 본인 페이지만 "오스카의 뉴스방", 없으면 "나의 뉴스방"
SITE_NAME=오스카
PAGES_PROJECT=daily-news
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# launchd 자동 실행은 PATH가 짧음 — npx 절대경로 (which npx)
NPX=/opt/homebrew/bin/npx
